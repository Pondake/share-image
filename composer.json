{
    "name": "pondake/share-image",
    "description": "Link preview images (og:image) that also show up in WhatsApp: 1200x630, under 300 kB, brand mark where thumbnails crop.",
    "type": "library",
    "license": "MIT",
    "keywords": ["og:image", "open graph", "whatsapp", "link preview", "social image", "gd"],
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Pondake\\ShareImage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pondake\\ShareImage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "examples": "@php examples/render.php"
    },
    "config": {
        "sort-packages": true
    }
}
